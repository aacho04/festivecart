# Flagsmith Client-Side Environment Key (safe to expose in front-end code)
# Get this from: Flagsmith Dashboard → Environment Settings → Client-side Environment Key
VITE_FLAGSMITH_ENVIRONMENT_KEY=your_client_side_environment_key_here

# --- Below: used ONLY by scripts/simulate.js and scripts/check-results.js ---
# Never put these in front-end code. Add to .gitignore. Never commit.

# Admin API key (from Flagsmith Account Settings)
FLAGSMITH_API_KEY=your_admin_api_key_here

# Environment key (shown in Flagsmith CLI as the environment identifier)
FLAGSMITH_ENV_KEY=your_environment_key_here

# Numeric experiment ID (from the POST /experiments/ response)
FLAGSMITH_EXPERIMENT_ID=your_experiment_id_here

# Numeric project ID (from the Flagsmith dashboard URL)
FLAGSMITH_PROJECT_ID=your_project_id_here

# Optional: Server-side SDK key (if using the Node.js server SDK separately)
# FLAGSMITH_SERVER_SIDE_KEY=ser.your_server_side_key_here
